      "fn": "projectWindow",
      "input": {
        "pct": 79.7,
        "resetsAt": "2026-06-12T11:00:00.000Z",
        "windowMs": 18000000,
        "nowMs": 1781258400000,
        "history": []
      },
      "expected": {
        "pct": 79.7,
        "resetsAt": "2026-06-12T11:00:00.000Z",
        "state": "safe",
        "basis": "window_avg",
        "etaAt": null,
        "projectedEndPct": 99,
        "recentRatePctPerHour": null
      }
    },
    {
