          { "at": "2026-06-05T12:00:00.000Z", "pct": 46, "resetsAt": "2026-06-07T12:24:00+00:00" },
          { "at": "2026-06-12T09:55:00.000Z", "pct": 58.8, "resetsAt": "2026-06-14T12:24:00+00:00" }
        ]
