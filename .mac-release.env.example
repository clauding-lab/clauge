# .mac-release.env.example
#
# Single source of truth for release-time identifiers + secrets.
# Copy this to `.mac-release.env` (gitignored) and fill in real values for
# local releases or manual signing flows.
#
# CI uses GitHub Secrets for the actual signing keys — this file is for
# local-machine release runs and rotation checklists. See
# docs/RELEASE_CHECKLIST.md for the rotation procedure.
#
# Pattern adopted from steipete/CodexBar. Part of A3 in the CodexBar
# adoption plan (v0.9.1).

# ─── Apple Developer account ─────────────────────────────────────────────────
# Team identifier issued by Apple. Visible in App Store Connect → Membership.
APPLE_TEAM_ID="CY4FK9S7X9"

# Apple ID used for notarization + ASC operations. NOT the primary Gmail.
APPLE_ID="adnan_du@yahoo.com"

# App-specific password generated at https://appleid.apple.com — used by
# `xcrun notarytool`. Rotate via Apple ID security → App-Specific Passwords.
# DO NOT COMMIT. Set in GitHub Secrets as APPLE_APP_SPECIFIC_PASSWORD.
APPLE_APP_SPECIFIC_PASSWORD=""

# ─── Bundle + ASC ────────────────────────────────────────────────────────────
# macOS bundle identifier — must match src-tauri/tauri.conf.json::bundle.identifier
# AND the keychain item names in src-tauri/src/claude_ai_session.rs.
BUNDLE_ID="com.clauding.clauge"

# App Store Connect numeric app ID — visible in the ASC app page URL.
ASC_APP_ID="6770303247"

# Provider short name — required by xcrun altool/notarytool when the Apple ID
# is a member of multiple teams. Lives in src-tauri/tauri.mas.conf.json on the
# mas-implement-session branch.
PROVIDER_SHORT_NAME=""

# ─── Sparkle / Tauri auto-updater ────────────────────────────────────────────
# Public endpoint serving latest.json. Must match the URL in
# src-tauri/tauri.conf.json::plugins.updater.endpoints.
UPDATER_ENDPOINT="https://clauding-lab.github.io/clauge/latest.json"

# Tauri signing keypair. Generated once via `cargo tauri signer generate`.
# DO NOT COMMIT. Set in GitHub Secrets as TAURI_SIGNING_PRIVATE_KEY and
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD.
TAURI_SIGNING_PRIVATE_KEY=""
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""

# ─── Account validity ────────────────────────────────────────────────────────
# Apple Developer account expires on this date. Renew before this in App Store
# Connect → Membership.
APPLE_DEV_ACCOUNT_EXPIRES="2027-05-17"
