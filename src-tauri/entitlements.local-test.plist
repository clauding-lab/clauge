<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- MAS local-test only. Same as entitlements.mas.plist MINUS the
         application-identifier + team-identifier keys.

         Those two keys are restricted entitlements that require a matching
         provisioning profile. The MAS provisioning profile is a PRODUCTION
         profile (App Store distribution), and macOS refuses to install
         Production profiles for direct launch (only Development profiles
         work for that). A Production-profile-bound .app cannot be
         double-clicked on the dev machine for sandbox-equivalent testing;
         the kernel rejects with AMFI error -413 ("No matching profile
         found") at launch.

         This stripped variant, combined with removing
         Contents/embedded.provisionprofile and re-signing with the real
         cert, lets the App Sandbox initialize without demanding a
         Development profile. The wizard race fix and sidecar entitlement
         fix can then be verified locally before paying the round-trip
         cost of a Transporter upload + Apple Review.

         NOT for Transporter upload. See scripts/build-mas-clean.sh for
         the two-mode flow. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
