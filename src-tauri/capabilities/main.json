{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Default permissions for Clauge main (dashboard) window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-spawn",
    "shell:allow-kill",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "updater:default",
    "notification:default",
    "window-state:default",
    "store:default"
  ]
}
