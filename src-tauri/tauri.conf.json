{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clauge",
  "version": "0.5.0",
  "identifier": "com.clauding.clauge",
  "build": {
    "beforeBuildCommand": "bash -c 'cd \"$(git rev-parse --show-toplevel)\" && bash scripts/build-sidecar.sh'",
    "frontendDist": "../popover"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/clauge-server"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.dmg.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0RUU5ODRBMzQ5NzU3OEUKUldTT1Y1YzBTcGp1OUs2aFVVTkRiOEtTS1R0bVBRc0kwbnRXMnZtYmd6V1MrYlViUXVqbktReXoK",
      "endpoints": [
        "https://clauding-lab.github.io/clauge/latest.json"
      ]
    }
  }
}
