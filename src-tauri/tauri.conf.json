{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clauge",
  "version": "1.3.2",
  "identifier": "com.clauding.clauge",
  "build": {
    "beforeBuildCommand": "node scripts/build-sidecar.mjs",
    "frontendDist": "../popover"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis"],
    "externalBin": ["binaries/clauge-server"],
    "resources": ["Resources/clauge-cli"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.dmg.plist"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0RUU5ODRBMzQ5NzU3OEUKUldTT1Y1YzBTcGp1OUs2aFVVTkRiOEtTS1R0bVBRc0kwbnRXMnZtYmd6V1MrYlViUXVqbktReXoK",
      "endpoints": [
        "https://clauding-lab.github.io/clauge/latest.json"
      ]
    }
  }
}
