# Clauge — environment overrides
#
# By default, Clauge fetches model pricing from LiteLLM and uses the model
# name embedded in each Claude Code JSONL turn (.message.model). The values
# below are FALLBACK overrides used only when LiteLLM lookup fails for a
# given model. They are kept in per-1M-token units to match Anthropic's
# published pricing format and divided by 1,000,000 internally.

# Per-1M-token rates (USD)
RATE_INPUT=3.00
RATE_OUTPUT=15.00
RATE_CACHE_READ=0.30
RATE_CACHE_CREATE=3.75
RATE_CACHE_CREATE_1H=6.00

# Subscription used for the API replacement value calculation
SUBSCRIPTION_COST=200

# Where Claude Code stores session JSONL files (verified shape: {session_uuid}.jsonl
# directly inside path-encoded project dirs, no /sessions/ subdir)
CLAUDE_DIR=~/.claude

# Server port (dashboard at http://localhost:$PORT)
PORT=3456
